# Withings API credentials — copy to ".env" in this folder and fill in.
# Get CLIENT_ID / CLIENT_SECRET from the Withings developer console.
# The access/refresh tokens are created automatically by: node withings.js auth me

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Filled in by the auth flow — leave blank initially.
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=

# Optional second user.
WITHINGS_ACCESS_TOKEN_WIFE=
WITHINGS_REFRESH_TOKEN_WIFE=
