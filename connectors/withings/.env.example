# Withings API credentials — copy this file to ".env" in the connector's code folder and fill in.
# Get CLIENT_ID / CLIENT_SECRET from https://developer.withings.com
# The access/refresh tokens are created automatically by:  node withings.js auth me

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Filled in by the auth flow — leave blank initially (primary person, "me").
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=

# Optional second person. Leave blank if not used.
WITHINGS_ACCESS_TOKEN_WIFE=
WITHINGS_REFRESH_TOKEN_WIFE=
