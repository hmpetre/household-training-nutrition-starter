# WHOOP API credentials — copy this file to ".env" in the connector's code folder and fill in.
# Get CLIENT_ID / CLIENT_SECRET from https://developer.whoop.com
# The access/refresh tokens are created automatically by:  node whoop.js auth me

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Filled in by the auth flow — leave blank initially (primary person, "me").
WHOOP_ACCESS_TOKEN=
WHOOP_REFRESH_TOKEN=

# Optional second person ("wife"/partner/etc.). Leave blank if not used.
WHOOP_ACCESS_TOKEN_WIFE=
WHOOP_REFRESH_TOKEN_WIFE=
